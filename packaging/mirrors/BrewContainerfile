# Build after Containerfile as localhost/epix-mirror-rust-qa:latest.
# Downloads are preparation only. Native fixture runs use --network none.
FROM localhost/epix-mirror-rust-qa:latest
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git curl procps file build-essential ruby && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 2000 mirrorqa && mkdir -p /home/linuxbrew/.linuxbrew \
    && chown -R mirrorqa:mirrorqa /home/linuxbrew
USER mirrorqa
WORKDIR /home/linuxbrew/.linuxbrew
# Exact stable Homebrew client and official core metadata used by the fixture.
RUN git init Homebrew && git -C Homebrew remote add origin https://github.com/Homebrew/brew \
    && git -C Homebrew fetch --depth 1 origin bf464f57275cae0be106b43d190c98564ac59b0e \
    && git -C Homebrew checkout --detach FETCH_HEAD \
    && mkdir bin && ln -s ../Homebrew/bin/brew bin/brew \
    && git init Homebrew/Library/Taps/homebrew/homebrew-core \
    && git -C Homebrew/Library/Taps/homebrew/homebrew-core remote add origin https://github.com/Homebrew/homebrew-core \
    && git -C Homebrew/Library/Taps/homebrew/homebrew-core fetch --depth 1 origin 5d320c851bd742f000ebf997bf2380c1d0957798 \
    && git -C Homebrew/Library/Taps/homebrew/homebrew-core checkout --detach FETCH_HEAD
RUN /home/linuxbrew/.linuxbrew/bin/brew ruby -e 'puts RUBY_VERSION'
ENTRYPOINT ["/usr/local/bin/epix-mirror-lab"]

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>EpixNet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The UI is the embedded node's HTTP server on 127.0.0.1. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- Private .epix hosts use the in-process TLS proxy and an app-only CA.
		     The navigation delegate still validates hostname, dates and chain
		     against that CA, and always normalizes these URLs to HTTPS. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>epix</key>
			<dict>
				<key>NSIncludesSubdomains</key><true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
			</dict>
		</dict>
	</dict>
	<!--
	  LAN peer discovery (AnnounceLocal, the local_discovery config key). iOS 14+
	  silently drops local-network traffic until the user accepts this prompt, so
	  without the key the UDP broadcasts go nowhere. The prompt appears only when
	  discovery is actually switched on - the feature ships disabled.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>EpixNet uses the local network to find other EpixNet peers nearby, so xites can sync directly between your devices - including with no internet connection. This is off unless you turn on local network discovery in Config.</string>
	<key>NSCameraUsageDescription</key>
	<string>EpixNet uses the camera to scan QR codes when pairing or signing with a Keystone hardware wallet.</string>
	<!-- epix:// links open the app directly (the Android intent-filter). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>zone.epix.EpixNet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>epix</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
